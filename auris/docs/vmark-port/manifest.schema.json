{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auris.local/schemas/vmark-port-manifest-v1.json",
  "title": "Auris VMark Port Manifest",
  "description": "Many-to-many provenance mappings from a pinned VMark revision to Auris.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "upstream", "entries"],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "const": "ISC"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "pathArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projectPath"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingId",
        "upstreamPaths",
        "aurisPaths",
        "disposition",
        "intentionalDifferences",
        "lastComparedCommit",
        "tests"
      ],
      "properties": {
        "mappingId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "upstreamPaths": {
          "$ref": "#/$defs/pathArray"
        },
        "aurisPaths": {
          "$ref": "#/$defs/pathArray"
        },
        "disposition": {
          "enum": ["copied", "adapted", "rewritten", "not-applicable"]
        },
        "intentionalDifferences": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "lastComparedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tests": {
          "$ref": "#/$defs/pathArray"
        }
      }
    }
  }
}
