{
  "name": "auris",
  "version": "1.0.4",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Auris — language learning through listening and shadowing.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "browser:smoke": "node tests/electron/browser-window-smoke.cjs",
    "browser:isolation": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-isolation-smoke.cjs",
    "browser:partition-isolation": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-partition-isolation-smoke.cjs",
    "browser:human-reclaim": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-human-reclaim-smoke.cjs",
    "browser:session": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-session-macos-smoke.cjs",
    "browser:dialog-feasibility": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-dialog-feasibility-smoke.cjs",
    "browser:ux-policy": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-ux-policy-smoke.cjs",
    "browser:crash-recovery": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-crash-recovery-smoke.cjs",
    "browser:security": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-security-macos-smoke.cjs",
    "browser:multiwindow": "env -u ELECTRON_RUN_AS_NODE electron tests/electron/browser-multiwindow-smoke.cjs",
    "browser:resource-budget": "node tests/electron/browser-resource-budget-smoke.cjs",
    "nia:workflow-smoke": "node tests/electron/nia-browser-workflow-smoke.cjs",
    "desktop:island:build": "node scripts/build-desktop-island-helper.cjs",
    "desktop:dev": "npm run desktop:island:build && node scripts/desktop-launcher.cjs --dev",
    "desktop:start": "npm run desktop:island:build && node scripts/desktop-launcher.cjs",
    "dictionary:sync": "node scripts/sync-personal-vocab.cjs",
    "mcp:notes": "node electron/auris-notes-mcp-server.mjs",
    "vmark:diff": "node scripts/vmark-sync-report.cjs",
    "lint": "eslint .",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:mcp-browser": "vitest run --config vitest.integration.config.ts tests/integration/mcp-browser-*.test.ts",
    "test:watch": "vitest",
    "playwright:test": "playwright test",
    "migration:status": "node scripts/migrate.js status",
    "migration:up": "node scripts/migrate.js up",
    "migration:down": "node scripts/migrate.js down",
    "migration:create": "node scripts/migrate.js create",
    "db:check": "node scripts/check-consistency.js check",
    "db:sync": "node scripts/check-consistency.js sync",
    "db:sync-sqlite": "node scripts/sync-sqlite-schema.js",
    "desktop:runtime-deps": "node scripts/assemble-electron-runtime-deps.cjs",
    "desktop:privacy:audit": "node scripts/audit-package-privacy.cjs .next/standalone",
    "desktop:assemble": "npm run desktop:runtime-deps && node scripts/assemble-standalone.cjs && npm run desktop:privacy:audit",
    "desktop:assemble:win": "npm run desktop:runtime-deps && node scripts/assemble-standalone.cjs --target=win32-x64 && npm run desktop:privacy:audit",
    "desktop:build:verify": "node scripts/verify-desktop-build.cjs",
    "desktop:release:build:mac": "npm run desktop:island:build && npm run build && npm run desktop:assemble && electron-builder --mac --publish always",
    "desktop:release:build:win": "npm run build && npm run desktop:assemble:win && electron-builder --win --config.npmRebuild=false --publish always",
    "desktop:release:check": "node scripts/publish-desktop-release.cjs --check",
    "desktop:release:local": "node scripts/publish-desktop-release.cjs",
    "desktop:release": "node scripts/prepare-desktop-release.cjs",
    "postinstall": "node scripts/copy-pdf-worker.cjs",
    "quality:desktop-ipc": "node scripts/verify-desktop-ipc-contract.cjs",
    "quality:feature-ledger": "node scripts/verify-feature-ledger.cjs"
  },
  "keywords": [
    "english",
    "shadowing",
    "nextjs",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dagrejs/dagre": "3.1.1",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/react-query": "^5.99.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.2",
    "electron-updater": "^6.6.2",
    "immer": "^11.1.4",
    "katex": "^0.16.45",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0",
    "next": "^16.1.7",
    "openai": "^6.32.0",
    "pdfjs-dist": "^5.7.284",
    "proper-lockfile": "^4.1.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "smol-toml": "^1.7.1",
    "sonner": "^2.0.7",
    "unified": "^11.0.5",
    "wordpos": "^2.1.0",
    "ws": "^8.20.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.7",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "node-pty": "^1.1.0"
  }
}
