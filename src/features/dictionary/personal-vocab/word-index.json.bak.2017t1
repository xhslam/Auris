          ]
        },
        {
          "title": "一语道破",
          "lines": [
            "“A green belt is a city's promise not to spread. 绿化带，是城市不向外扩张的承诺。”"
          ]
        }
      ],
      "source": {
        "kaoyan": "考研英语一 2016 Text 2"
      }
