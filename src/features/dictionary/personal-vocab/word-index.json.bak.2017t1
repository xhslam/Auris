      "definition": "批发；批发的；大规模地",
      "fileName": "2809-wholesale.md",
      "lookupKey": "wholesale",
      "partOfSpeech": "",
      "pronunciations": [
        "/ˈhoʊlˌseɪl/"
      ],
      "sections": [
