          ]
        },
        {
          "title": "一语道破",
          "lines": [
            "\"To be in one's prime is to bloom before the fall. in one's prime，是凋零之前的盛放。\""
          ]
        }
      ],
      "source": {
        "note": "考研英语一 2012 Text 4"
      }
